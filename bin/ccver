#!/bin/zsh
setopt no_unset

CCVER_ROOT="${0:A:h:h}"
source "$CCVER_ROOT/lib/config.zsh"
source "$CCVER_ROOT/lib/versions.zsh"
source "$CCVER_ROOT/lib/pin.zsh"
export CCVER_ROOT
source "$CCVER_ROOT/lib/progress.zsh"
source "$CCVER_ROOT/lib/installer.zsh"
source "$CCVER_ROOT/lib/ui.zsh"

function main() {
    local command_name="${1:-ls}" selector target rc limit
    [[ $# -gt 0 ]] && shift
    case "$command_name" in
        ls|list) ccver_print_list ;;
        remote) ccver_print_remote "${1:-30}" ;;
        install)
            selector="${1:-}"
            [[ -n "$selector" ]] || { echo "用法: ccver install <版本|latest>" >&2; return 1; }
            target="$(ccver_resolve_selector "$selector")" || return $?
            ccver_install_preserve_default "$target"; rc=$?
            [[ "$rc" -eq 0 ]] || return "$rc"
            ccver_print_list
            ;;
        use)
            selector="${1:-}"
            [[ -n "$selector" ]] || { echo "用法: ccver use <版本|latest|local-latest|current>" >&2; return 1; }
            target="$(ccver_resolve_selector "$selector")" || return $?
            if [[ "$selector" != current ]]; then
                ccver_ensure_installed "$target"; rc=$?
                [[ "$rc" -eq 0 ]] || return "$rc"
            fi
            ccver_switch_default "$target"
            ;;
        pin)
            selector="${1:-}"
            if [[ -z "$selector" ]]; then
                target="$(ccver_pinned)"
                echo "${target:-未设置}"
                return 0
            fi
            target="$(ccver_resolve_selector "$selector")" || return $?
            if [[ "$selector" != current && "$selector" != local-latest && "$selector" != installed-latest ]]; then
                ccver_ensure_installed "$target"; rc=$?
                [[ "$rc" -eq 0 ]] || return "$rc"
            fi
            [[ -x "$CCVER_VERSIONS_DIR/$target" ]] || { echo "未安装版本 $target" >&2; return 1; }
            ccver_pin_only "$target"
            ;;
        unpin) ccver_unpin ;;
        help|-h|--help) ccver_help ;;
        *) echo "未知命令: $command_name" >&2; ccver_help >&2; return 1 ;;
    esac
}

main "$@"
